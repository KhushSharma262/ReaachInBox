# ============================================================
# ReachInbox Email Scheduler — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file.
# ============================================================

# ─── DATABASE ────────────────────────────────────────────────
# PostgreSQL connection string (provided by Docker Compose locally)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reachinbox?schema=public"

# ─── REDIS ───────────────────────────────────────────────────
# Redis connection URL (provided by Docker Compose locally)
REDIS_URL="redis://localhost:6379"

# ─── GOOGLE OAUTH ────────────────────────────────────────────
# Create at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI (local): http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ─── NEXTAUTH / AUTH.JS ──────────────────────────────────────
# Must be >= 32 random characters. Generate with:
# PowerShell: [System.Convert]::ToBase64String([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
AUTH_SECRET="your-auth-secret-minimum-32-characters-long"

# The public URL of the frontend (used by NextAuth for callbacks)
NEXTAUTH_URL="http://localhost:3000"

# ─── URLS ────────────────────────────────────────────────────
FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:3001"

# ─── WORKER SETTINGS ─────────────────────────────────────────
# Number of emails the worker processes concurrently
WORKER_CONCURRENCY=5

# Minimum delay between emails in milliseconds (e.g., 2000 = 2 seconds)
MIN_EMAIL_DELAY_MS=2000

# Maximum emails sent per hour (global across all senders)
MAX_EMAILS_PER_HOUR=200

# ─── ETHEREAL SMTP (Auto-created on first run) ───────────────
# These are seeded automatically when you run: npm run seed:senders
# You can override with real SMTP credentials for testing
ETHEREAL_USER_1=""
ETHEREAL_PASS_1=""
ETHEREAL_USER_2=""
ETHEREAL_PASS_2=""
ETHEREAL_USER_3=""
ETHEREAL_PASS_3=""

# ─── API SECURITY ────────────────────────────────────────────
# Secret used to sign express-session (used for upload sessions)
SESSION_SECRET="your-session-secret-minimum-32-characters"

# ─── NODE ENVIRONMENT ────────────────────────────────────────
NODE_ENV="development"
PORT=3001
